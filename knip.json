{
  "workspaces": {
    ".": {
      "entry": [
        "tests/**/*.test.ts",
        "tests/**/*.e2e.ts",
        "tests/support/*.ts",
        "*.config.ts",
        "tools/*.mjs"
      ],
      "project": ["tests/**/*.ts", "*.config.ts", "*.mjs", "tools/*.mjs"]
    },
    "apps/client": {
      "entry": ["src/hud/index.ts", "src/audio/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/telemetry": {
      "project": ["src/**/*.ts"]
    }
  },
  "ignoreBinaries": ["wasm-bindgen"]
}
