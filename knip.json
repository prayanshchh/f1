{
  "workspaces": {
    ".": {
      "entry": [
        "tests/**/*.test.ts",
        "tests/**/*.e2e.ts",
        "tests/support/*.ts",
        "*.config.ts",
        "tools/*.mjs",
        ".github/scripts/*.ts"
      ],
      "project": [
        "tests/**/*.ts",
        "*.config.ts",
        "*.mjs",
        "tools/*.mjs",
        ".github/scripts/*.ts"
      ]
    },
    "apps/client": {
      "entry": ["src/hud/index.ts", "src/contracts/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/telemetry": {
      "project": ["src/**/*.ts"]
    }
  },
  "ignoreBinaries": ["wasm-bindgen"]
}
