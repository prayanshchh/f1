{
  "workspaces": {
    ".": {
      "entry": [
        "tests/**/*.test.ts",
        "tests/**/*.e2e.ts",
        "tests/support/*.ts",
        "*.config.ts",
        "tools/*.mjs",
        "tools/ai/*.mjs"
      ],
      "project": [
        "tests/**/*.ts",
        "*.config.ts",
        "*.mjs",
        "tools/*.mjs",
        "tools/ai/*.mjs"
      ]
    },
    "apps/client": {
      "entry": ["pad-server.ts"],
      "project": ["src/**/*.ts"]
    }
  },
  "ignoreBinaries": ["em\\+\\+", "openssl", "scutil", "blender", "uv"]
}
