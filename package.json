{
  "name": "revracers",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.0",
      "onFail": "download"
    }
  },
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "pnpm --filter ./apps/client run dev",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore",
    "lint": "pnpm run worker:types && ast-grep scan --no-ignore hidden && eslint --max-warnings 0 .",
    "worker:types": "wrangler types apps/worker/worker-configuration.d.ts > /dev/null",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/client/tsconfig.json && tsc --noEmit -p apps/api/tsconfig.json && pnpm run worker:types && tsc --noEmit -p apps/worker/tsconfig.json",
    "unused": "knip",
    "duplicates": "jscpd .",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run unused && pnpm run duplicates",
    "build": "pnpm run build:engine && pnpm --filter ./apps/client run build",
    "build:engine": "node tools/build-engine.mjs",
    "deploy": "gh workflow run deploy.yml -R prayanshchh/revracers --ref main",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "pnpm run check && pnpm run build && pnpm run test && pnpm run test:e2e",
    "content:cars": "node tools/cars.mjs",
    "assets:build": "node tools/assets.mjs"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.51.0",
    "@eslint/js": "10.0.1",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.64.1",
    "@types/emscripten": "1.41.6",
    "@types/node": "26.6.5",
    "@types/pngjs": "6.0.5",
    "@types/three": "0.186.0",
    "@vitest/eslint-plugin": "1.6.27",
    "@webgpu/types": "0.1.74",
    "eslint": "10.13.0",
    "eslint-plugin-playwright": "2.12.1",
    "globals": "17.13.0",
    "jscpd": "5.4.1",
    "knip": "6.41.0",
    "ktx2-encoder": "0.6.0",
    "lefthook": "2.2.2",
    "meshoptimizer": "1.3.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "three": "0.186.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "^4.157.0",
    "yaml": "2.9.1"
  }
}
