{
  "workspaces": {
    ".": {
      "entry": [
        "tests/**/*.test.ts",
        "tests/**/*.e2e.ts",
        "tests/support/*.ts",
        "*.config.ts",
        "tools/*.mjs"
      ],
      "project": ["tests/**/*.ts", "*.config.ts", "*.mjs", "tools/*.mjs"]
    },
    "apps/client": {
      "entry": ["pad-server.ts", "api-server.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["flag-icons"]
    },
    "apps/api": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    }
  },
  "ignoreBinaries": ["em\\+\\+", "openssl", "scutil", "blender", "uv"]
}
