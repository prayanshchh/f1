{
  "workspaces": {
    ".": {
      "entry": [
        "tests/**/*.test.ts",
        "tests/**/*.e2e.ts",
        "tests/support/*.ts",
        "tests/pad/network/*.ts",
        "*.config.ts",
        "tools/*.mjs",
        "tools/ai/*.mjs"
      ],
      "project": [
        "tests/**/*.ts",
        "*.config.ts",
        "*.mjs",
        "tools/*.mjs",
        "tools/ai/*.mjs"
      ]
    },
    "apps/client": {
      "entry": ["api-server.ts", "engine-build.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["flag-icons"]
    },
    "apps/api": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    }
  },
  "ignoreBinaries": ["em\\+\\+", "blender", "uv", "ios_webkit_debug_proxy"]
}
